# School-Plan Environment Configuration (copy to `.env` and fill in your URLs/paths)
# `.env` is gitignored and loaded automatically by config.py, browser_harvester.js, and sync.sh.

# Local LM Studio OpenAI-compatible server
SCHOOL_LMS_URL=http://127.0.0.1:1234
SCHOOL_LMS_MODEL=google/gemma-4-e4b
SCHOOL_LMS_BIN=~/.lmstudio/bin/lms

# Chromium read-only DevTools Protocol endpoint
SCHOOL_CDP_URL=http://127.0.0.1:9222
SCHOOL_CHROMIUM_PORT_FILE=~/.config/chromium/DevToolsActivePort

# Academic platform URLs
SCHOOL_CLASSROOM_URL=https://classroom.google.com
SCHOOL_CLASSROOM_ACCOUNT_INDEX=0
SCHOOL_OUTLOOK_URL=https://outlook.cloud.microsoft/mail/
SCHOOL_OUTLOOK_HOSTS=outlook.cloud.microsoft,outlook.live.com

# Calendar & local study folders
SCHOOL_CALENDAR_UID_DOMAIN=school-plan.local
SCHOOL_GROUP_LABEL=S1 IIR4 G4
SCHOOL_DOCS_DIR=~/Documents/9raya
SCHOOL_STUDY_PLAN_PATH=~/Documents/9raya/STUDY_PLAN_CC1_4IIR.md
SCHOOL_DOWNLOADS_DIR=~/Downloads
